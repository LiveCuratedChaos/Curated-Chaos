{
  "name": "curated-chaos-isolated-development",
  "version": "3.5.0",
  "private": true,
  "type": "module",
  "description": "M3D Phase 2: multi-subtask editing with one save",
  "scripts": {
    "start": "node tools/local-server.mjs",
    "setup:reuse": "node tools/reuse-dev-config.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:rls": "node tools/verify-rls.mjs",
    "backup:private": "node tools/private-recovery.mjs --create",
    "check:privacy": "node tools/check-repository-privacy.mjs",
    "check:setup": "node tools/preflight.mjs",
    "start:connections": "node tools/connections-server.mjs",
    "check:release": "node tools/verify-local-release.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "google-auth-library": "11.3.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15"
  }
}
